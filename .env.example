# ==============================================================================
# Enterprise Social Media Management Dashboard - Environment Configuration
# ==============================================================================
# Copy this file to `.env` at the repository root and fill in the values:
#
#   cp .env.example .env
#
# The Next.js app (apps/web) loads this file automatically via dotenv-flow
# convention: root `.env` is the single source of truth for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------------------
# Database - PostgreSQL 16 (see docker-compose.yml)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://dashboard:change_me_in_env@localhost:5432/social_dashboard?schema=public
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=social_dashboard
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Queue / Cache - Redis 7 (see docker-compose.yml)
# Used by BullMQ for the scheduler, auto-reply, media processing and
# live-stream supervisor queues.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Security - token encryption (AES-256-GCM)
# 32-byte key as 64 hex chars. Generate with:  openssl rand -hex 32
# Used to encrypt OAuth tokens stored in the database.
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# Authentication - NextAuth.js
# Generate a secret with:  openssl rand -base64 32
# ------------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# AI Providers
# At least ONE provider must be configured. The dashboard's AI abstraction
# layer (packages/ai) routes every AI feature through the provider selected
# here, or through a per-workspace override stored in the database.
#
#   AI_DEFAULT_PROVIDER = openai | anthropic | ollama | lmstudio
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=openai

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Ollama (local server / router)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LM Studio (local server, OpenAI-compatible endpoint)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=lm-studio

# ------------------------------------------------------------------------------
# Social OAuth - Facebook & Instagram (Meta)
# Create an app at https://developers.facebook.com/apps
# Required scopes are requested dynamically by apps/web/src/lib/oauth/*
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback
# Instagram uses the same Meta app; register this redirect URI in the Meta app too.
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# ------------------------------------------------------------------------------
# Social OAuth - TikTok
# Create an app at https://developers.tiktok.com/apps
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# ------------------------------------------------------------------------------
# Social OAuth - YouTube (Google)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Enable the YouTube Data API v3 for the project.
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# ------------------------------------------------------------------------------
# Social OAuth - X (Twitter)
# Create an app at https://developer.x.com/en/portal/dashboard
# OAuth 2.0 with PKCE is used; enable "Read and write" permissions.
# ------------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/oauth/x/callback

# ------------------------------------------------------------------------------
# Social OAuth - Threads (Meta)
# Create an app at https://developers.facebook.com/apps (Threads use case)
# ------------------------------------------------------------------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback

# ------------------------------------------------------------------------------
# Webhooks - inbound platform events (comments, mentions, live status)
# Shared secret used to verify webhook signatures from Meta/TikTok/etc.
# WEBHOOK_VERIFY_TOKEN is the plain token Meta sends back during the
# hub.challenge verification handshake.
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=replace_me_with_a_long_random_string
WEBHOOK_VERIFY_TOKEN=replace_me_with_a_long_random_string
WEBHOOK_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Streaming - FFmpeg to RTMP (auto live-stream feature)
# FFMPEG_PATH must point at a static ffmpeg binary with libx264 + aac.
# STREAMING_SERVICE_URL is the control-plane HTTP API (packages/streaming).
# ------------------------------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
STREAMING_SERVICE_URL=http://localhost:8090
STREAM_RECORDINGS_DIR=./storage/recordings
STREAM_DEFAULT_BITRATE=4500k
STREAM_DEFAULT_FPS=30

# ------------------------------------------------------------------------------
# Media storage - local disk (swap for S3-compatible storage in production)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=512

# ------------------------------------------------------------------------------
# Feature flags - can also be toggled per-workspace in the dashboard UI
# ------------------------------------------------------------------------------
AUTO_REPLY_ENABLED=true
SCHEDULER_ENABLED=true
LIVESTREAM_ENABLED=true
SENTIMENT_ANALYSIS_ENABLED=true
CONTENT_STUDIO_ENABLED=true
