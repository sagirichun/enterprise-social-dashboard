{"description":"All-in-One Enterprise Social Media Management Dashboard","devDependencies":{"eslint":"^8.57.1","prettier":"^3.3.3","turbo":"^2.3.4","typescript":"^5.6.3"},"engines":{"node":">=20.0.0","npm":">=10.0.0"},"license":"UNLICENSED","name":"enterprise-social-dashboard","packageManager":"npm@10.8.3","private":true,"scripts":{"build":"turbo run build","clean":"turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules","db:generate":"npm run db:generate --workspace=@dashboard/db","db:migrate":"npm run db:migrate --workspace=@dashboard/db","db:migrate:deploy":"npm run db:migrate:deploy --workspace=@dashboard/db","db:seed":"npm run db:seed --workspace=@dashboard/db","db:studio":"npm run db:studio --workspace=@dashboard/db","dev":"turbo run dev","format":"prettier --write \"**/*.{ts,tsx,js,json,md}\"","format:check":"prettier --check \"**/*.{ts,tsx,js,json,md}\"","lint":"turbo run lint","test":"turbo run test","typecheck":"turbo run typecheck","worker":"npm run worker --workspace=@dashboard/web","worker:dev":"npm run worker:dev --workspace=@dashboard/web"},"version":"1.0.0","workspaces":["apps/*","packages/*"]}